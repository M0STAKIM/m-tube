# Copy to .env for local/VPS use (dotenv loads it). On Vercel set these in Project Settings -> Environment Variables.

# Port for `node index.js` (default 3000)
PORT=3000
# 32+ random chars that seal download tokens. REQUIRED on Vercel (openssl rand -hex 32).
# Local/VPS: if empty, a random secret is generated once into data/storage/.secret
APP_SECRET=
# Fills every provider whose key in mostakim.json is still a placeholder
RAPIDAPI_KEY=
# Optional per-provider overrides: PROVIDER_<ID>_API_KEY / _ENABLED / _PRIORITY
# PROVIDER_ALL_IN_ONE_ULTIMATE_API_KEY=

# 16+ chars; enables /api/v1/keys, /api/v1/diagnostics and /api/v1/storage
ADMIN_TOKEN=
# Comma-separated static API keys (16+ chars each); more keys can be created via /api/v1/keys
API_KEYS=
# Comma-separated allowed browser origins for API clients
CORS_ORIGINS=
# Requests per minute: per IP for all /api calls, per API key, per website visitor
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_API=60
RATE_LIMIT_WEB=30
RATE_LIMIT_ADMIN=30
# 1 only when running behind a trusted reverse proxy (nginx, Cloudflare...)
TRUST_PROXY=0

# stream (default, nothing stored) | file (stage in data/storage/temp, exact Content-Length) | redirect (302 to provider)
DOWNLOAD_MODE=stream
# sdk (official MCP SDK, auto-fallback to built-in client) | builtin
MCP_CLIENT=sdk

# JSON database / storage locations (defaults: data/database and data/storage)
# DB_DIR=
# STORAGE_DIR=
# off = do not write download/search history and analytics
JSON_DB_LOGGING=on
# Vercel only: Vercel Blob token makes the JSON database persistent (encrypted objects). Without it Vercel data is EPHEMERAL.
BLOB_READ_WRITE_TOKEN=
